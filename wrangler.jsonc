{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reciwake",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "routes": [{ "pattern": "reciwake.kotek7.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "ai": { "binding": "AI" },
  "vars": { "RECEIPT_SCAN_DAILY_LIMIT": "200" },
  "ratelimits": [
    {
      "name": "RECEIPT_SCAN_LIMITER",
      "namespace_id": "202610031",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ReceiptRoom" },
      { "name": "RECEIPT_SCAN_BUDGET", "class_name": "ReceiptScanBudget" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReceiptRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ReceiptScanBudget"] },
  ],
}
